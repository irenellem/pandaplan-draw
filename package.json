{
  "name": "pandaplan-draw",
  "private": true,
  "version": "0.1.0",
  "description": "PandaPlan Draw - diagram-first workspace served at /draw/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4188 --strictPort",
    "typecheck": "tsc -b",
    "test": "node --test test/worker.test.mjs test/client.test.mjs test/offline.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:perf": "node test/perf.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "lucide-react": "0.577.0",
    "marked": "18.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
